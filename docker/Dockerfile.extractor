# Motor de extração: Node + yt-dlp + ffmpeg
FROM node:22-alpine

RUN apk add --no-cache ffmpeg python3 ca-certificates curl \
  && curl -L https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp -o /usr/local/bin/yt-dlp \
  && chmod +x /usr/local/bin/yt-dlp

WORKDIR /app
COPY extractor/package.json ./package.json
COPY extractor/server.js ./server.js

ENV PORT=8080
ENV YTDLP_PATH=/usr/local/bin/yt-dlp
EXPOSE 8080

# Atualiza o yt-dlp no start (as fontes mudam com frequência) e sobe o serviço.
CMD ["sh", "-c", "/usr/local/bin/yt-dlp -U >/dev/null 2>&1 || true; node server.js"]
